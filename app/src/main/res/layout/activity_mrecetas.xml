<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#DEC70C0C"
    tools:context=".m_recetas">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#DEC80D0D"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imageView3"
                android:layout_width="314dp"
                android:layout_height="96dp"
                android:layout_weight="1"
                app:srcCompat="@drawable/_5d86623_badb_4221_8acd_b8ae8c290809_removebg_preview" />

            <Button
                android:id="@+id/btn_atras"
                android:layout_width="141dp"
                android:layout_height="69dp"
                android:layout_weight="1"
                android:text="Atras" />

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rycrecetas"
            android:layout_width="match_parent"
            android:layout_height="562dp"
            android:background="#EDC3C1" />

        <Button
            android:id="@+id/btn_receta1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ir a ..." />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>