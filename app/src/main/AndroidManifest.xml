<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 1. PERMISOS: Se declara el permiso para usar la cámara -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- 2. CARACTERÍSTICAS: Se declara que la app puede usar la cámara, pero no es obligatorio -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- 3. APLICACIÓN -->
    <application
        android:name=".ElqhApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ELQH"
        tools:targetApi="31">

        <!-- 4. DECLARACIÓN DE ACTIVITIES -->

        <!-- ✅ ACTIVIDAD DE INICIO (LAUNCHER) -->
        <!-- Esta es la pantalla que se abre al iniciar la app. Ya está configurada correctamente. -->
        <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- El resto de tus Activities no necesitan el intent-filter de LAUNCHER -->
        <activity
            android:name=".inicio"
            android:exported="false" />
        <activity
            android:name=".ingrdientes"
            android:exported="false" />
        <activity
            android:name=".m_recetas"
            android:exported="false" />
        <activity
            android:name=".RecetaDetalleActivity"
            android:exported="false" />
        <activity
            android:name=".perfil"
            android:exported="false" />
        <activity
            android:name=".registro"
            android:exported="false" />

        <!-- 5. DECLARACIÓN DEL FILEPROVIDER -->
        <!-- Esencial para que la cámara pueda guardar la foto sin que la app falle. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>

